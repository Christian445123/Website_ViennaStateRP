# ============================================================
#  ViennaStateRP – Umgebungsvariablen (Vorlage)
#  Kopieren zu ".env" und mit echten Werten befüllen.
#  SPEICHERORT: NICHT im Webroot (public_html/htdocs), sondern eine Ebene darüber,
#  z. B. /home/vsrp/.env – dort kann sie nicht per Browser heruntergeladen werden.
#  Alternativ beliebiger Pfad über die Umgebungsvariable VSRP_ENV_FILE.
#  Die ".env" selbst NIEMALS committen!
#  Passwörter mit encrypt_env.php verschlüsseln → ENC:...
# ============================================================

# ── Verschlüsselungs-Key (MUSS als erstes stehen) ──
# Alternativ: /home/vsrp/vsrp.key Datei außerhalb des Webroot
VSRP_SECRET_KEY=

# ── Datenbank ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# ── Site ──
SITE_NAME=ViennaStateRP
SITE_URL=

# ── FiveM Server ──
FIVEM_IP=
FIVEM_PORT=30120

# ── Dev-Server (nur Online/Offline-Anzeige auf der Statusseite) ──
DEV_SERVER_IP=
DEV_SERVER_PORT=30120

# ── Discord OAuth2 ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_GUILD_ID=
DISCORD_INVITE=
# Bot-Token für den automatischen Discord-Rollen-Sync (Bot-Tab in eurer Discord-App, "Reset Token")
DISCORD_BOT_TOKEN=

# ── FiveM Server API ──
FIVEM_API_URL=
# Gemeinsamer geheimer Schlüssel zwischen Website und FiveM-Resource
FIVEM_BRIDGE_SECRET=

# ── Discord Logging Webhook ──
DISCORD_LOGGING_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_BOT_NAME=
DISCORD_BOT_AVATAR=

# ── Discord Changelog-Ankündigungen (eigener Kanal) ──
DISCORD_CHANGELOG_WEBHOOK_URL=

# ── Discord-Rollen-Sync: Berichtskanal (eigener Kanal) ──
DISCORD_ROLE_SYNC_WEBHOOK_URL=

# ── Cron-Secret: schützt die per Server-Cronjob aufgerufenen Skripte (api/*_cron.php) ──
CRON_SECRET=
# WICHTIG: Ohne CRON_SECRET sind api/changelog_cron.php, api/log_status.php und
# api/discord_role_sync_cron.php gesperrt. Langen Zufallswert verwenden (z. B. 40+ Zeichen).
# Aufruf bevorzugt per Header:  curl -H "X-Cron-Secret: ..." https://.../api/log_status.php

# ── Reverse-Proxy / Cloudflare ──
# Nur Anfragen von diesen Adressen (IP oder CIDR, kommagetrennt) dürfen X-Forwarded-For /
# CF-Connecting-IP setzen. Loopback ist immer vertraut. Läuft die Seite hinter Cloudflare,
# hier dessen IP-Bereiche eintragen (https://www.cloudflare.com/ips/), sonst wird für
# Rate-Limits die Proxy-IP statt der Besucher-IP verwendet.
TRUSTED_PROXIES=

# ── Diagnose (nur bei Bedarf setzen, danach wieder entfernen; mind. 16 Zeichen) ──
DIAG_TOKEN=

# ── E-Mail-Bestätigung (Passwort-Registrierung) ──
# Absenderadresse; der Server braucht einen funktionierenden Mailversand (PHP mail()/sendmail).
MAIL_FROM=
# Auf "false" setzen, falls der Mailversand nicht funktioniert (Registrierung ohne Bestätigung).
REQUIRE_EMAIL_VERIFICATION=true
