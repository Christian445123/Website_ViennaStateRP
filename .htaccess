# ============================================================
#  ViennaStateRP – Apache .htaccess
# ============================================================

Options -Indexes -MultiViews
ServerSignature Off

# ── Sicherheit: Sensible Dateien sperren ────────────────────
# Dotfiles (.env, .git, .vscode, .htaccess …) niemals ausliefern
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Server-interne Skripte, Konfigurations- und Datenbankdateien
# (db.php im Root ist Legacy-Code ohne Zweck im Web; Diagnose-/Migrationsskripte
#  sind zusätzlich per Login/Token geschützt – hier die erste Verteidigungslinie)
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|schema\.sql|encrypt_env\.php|migrate(_fraktionen)?\.php|db\.php|settings\.json|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|log|key|lock|sh|md|enc|bak|old|orig|swp|ini|env|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# includes/ und process/ direkt sperren
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Direkte Aufrufe auf includes/ verbieten
    RewriteRule ^includes/ - [F,L]

    # Direkte Aufrufe auf process/ nur POST erlauben (kein Browser-direktaufruf)
    RewriteCond %{REQUEST_METHOD} !^POST$
    RewriteRule ^process/ - [F,L]

    # Versteckte Ordner (.git, .vscode, …) sperren
    RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>

# ── PHP Einstellungen ───────────────────────────────────────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_flag expose_php Off
    php_value error_log /var/log/vsrp_php_errors.log
    php_flag session.cookie_httponly On
    php_value session.cookie_samesite Lax
    php_flag session.use_strict_mode On
    php_flag session.use_only_cookies On
    php_value max_execution_time 30
    php_value upload_max_filesize 8M
    php_value post_max_size 8M
</IfModule>

# ── Sicherheits-Header ──────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    # Veralteter XSS-Auditor ist selbst angreifbar → deaktivieren, CSP übernimmt
    Header always set X-XSS-Protection "0"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always unset X-Powered-By
    Header always unset Server

    # HSTS (nur wenn die Seite über HTTPS ausgeliefert wird; erst nach Test mit includeSubDomains/preload erweitern)
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"

    # Content-Security-Policy
    # 'unsafe-inline' ist nötig, solange Seiten Inline-<script>/-<style> und onclick= nutzen.
    # Schutz bieten trotzdem: keine fremden Skripte (außer Google Analytics nach Consent),
    # keine Plugins, keine Fremd-Formulare, kein Einbetten durch Dritte, fixe <base>.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

    # API-Antworten nie cachen / sniffen lassen
    <LocationMatch "^/api/">
        Header always set Cache-Control "no-store"
    </LocationMatch>
</IfModule>

# ── Caching für Assets ──────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png            "access plus 30 days"
    ExpiresByType image/jpg            "access plus 30 days"
    ExpiresByType image/jpeg           "access plus 30 days"
    ExpiresByType image/webp           "access plus 30 days"
    ExpiresByType image/x-icon         "access plus 30 days"
</IfModule>

# ── Komprimierung ───────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>
